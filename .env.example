# Copy to .env and fill in whichever keys you have. All providers are optional.
# The pipeline tries them in the order given by LLM_PROVIDER_ORDER and falls through
# on rate limits or outages. Tests never need a key.

LLM_PROVIDER_ORDER=groq,gemini,openrouter,cerebras

# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
# Free quotas are counted per model, so listing two is two allowances and the
# client uses whichever is free. Avoid reasoning models here: they spend their
# output budget thinking and return truncated JSON.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# https://openrouter.ai/keys  (models suffixed :free cost nothing)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# https://cloud.cerebras.ai  (free tier)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Where the SQLite knowledge layer lives.
FACTLAYER_DB=factlayer.db

# Uploaded PDFs are kept so evidence quotes stay verifiable after ingestion.
FACTLAYER_UPLOADS=uploads

# Two values that differ by less than this fraction are treated as the same number.
FACTLAYER_VALUE_TOLERANCE=0.005

# Requests per minute, counted per provider AND per model. Keep it just below the
# published limit so the client paces itself instead of collecting 429s. Gemini's
# free tier is 15/min per model, hence 14. 0 turns pacing off.
FACTLAYER_RPM=14

# Read at most this many pages per upload (0 = no limit). Upload the same file
# again to continue from where it stopped.
FACTLAYER_MAX_PAGES=0

# Parallel page readers.
FACTLAYER_WORKERS=4
