# Copy to .env and fill in whichever keys you have. All providers are optional.
# The pipeline tries them in the order given by LLM_PROVIDER_ORDER and falls through
# on rate limits or outages. Tests never need a key.

LLM_PROVIDER_ORDER=groq,gemini,openrouter,cerebras

# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
# Free quotas are counted per model, so listing two is two allowances and the
# client uses whichever is free. Avoid reasoning models here: they spend their
# output budget thinking and return truncated JSON.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# https://openrouter.ai/keys  (models suffixed :free cost nothing)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# https://cloud.cerebras.ai  (free tier)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Or skip the cloud entirely: https://ollama.com running on this same machine.
# No key, no network, no shared quota, nothing to rate-limit — the trade is
# whatever your own hardware can do. Uncomment these three and comment out
# LLM_PROVIDER_ORDER above; `ollama list` shows which model name to use if you
# already have one pulled.
# LLM_PROVIDER_ORDER=ollama
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=llama3.1
# Also set FACTLAYER_MAX_PAGES=1, FACTLAYER_WORKERS=1 and FACTLAYER_RPM=0 further
# down — CPU inference is slower per page than any of the cloud providers, and
# those three together are what keep the progress bar moving in small, visible
# steps instead of one long wait with nothing to show for it.

# Where the SQLite knowledge layer lives.
FACTLAYER_DB=factlayer.db

# Uploaded PDFs are kept so evidence quotes stay verifiable after ingestion.
FACTLAYER_UPLOADS=uploads

# Two values that differ by less than this fraction are treated as the same number.
FACTLAYER_VALUE_TOLERANCE=0.005

# Requests per minute, counted per provider AND per model. Keep it just below the
# published limit so the client paces itself instead of collecting 429s. Gemini's
# free tier is 15/min per model, hence 14. 0 turns pacing off — set it to 0 for
# Ollama, which has no published quota to stay under; the only limit is your own
# hardware, and Ollama already queues what it cannot run at once.
FACTLAYER_RPM=14

# Read at most this many pages per upload (0 = no limit). Upload the same file
# again to continue from where it stopped. 0 means a long PDF is read in one
# request that can run for minutes with nothing to show for it in between; the
# web page chains requests and shows real progress between them, so there is no
# reason to leave this unbounded. On CPU-only Ollama especially, drop this to 1 —
# a single page can already take a while to generate, and one number moving is
# worth more than a wall of silence.
FACTLAYER_MAX_PAGES=3

# Parallel page readers. Cloud providers benefit from a few running at once; a
# single local Ollama instance processes one request at a time regardless; set
# this to 1 for Ollama so pages queue predictably instead of all starting and
# then waiting on each other.
FACTLAYER_WORKERS=4
